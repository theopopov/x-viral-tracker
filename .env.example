# x-viral-tracker environment variables
# The tool reads APIFY_TOKEN from the process environment (stdlib only — it does NOT
# auto-load this file). Either export the variable directly:
#     export APIFY_TOKEN=your_apify_token_here
# or copy this file to .env, fill it in, and load it into your shell before running:
#     set -a; source .env; set +a
# Never commit a real token.

# Your Apify API token. Get it from: Apify Console -> Settings -> API & Integrations.
# https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_token_here
